# Copy to server/.env and fill in. NEVER commit the real .env.

# Postgres (use a shared cloud DB like Neon/Supabase so all 3 devices share data,
# OR use SQLite for zero-setup: DATABASE_URL="file:./dev.db")
DATABASE_URL="postgresql://user:password@localhost:5432/transitops?schema=public"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Server
PORT=4000
CLIENT_URL="http://localhost:5173"
